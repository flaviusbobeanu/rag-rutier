# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM backend to use: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# Anthropic (Claude API). Create a key at console.anthropic.com -> API keys.
# The API is billed separately from a Claude Pro subscription.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# How much the model thinks before answering: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval: vector | bm25 | hybrid, and an optional cross-encoder reranker (much better ranking,
# but ~7 s per question on CPU; well under 1 s on a GPU)
RETRIEVAL_MODE=vector
USE_RERANKER=false

# Where ChromaDB stores its index on disk
CHROMA_DIR=chroma_db

# OCR for scanned fines: full path to tesseract.exe, only if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
